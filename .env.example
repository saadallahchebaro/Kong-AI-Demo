# Copied to .env by ./setup.sh, which asks for the empty values. Keep .env out of Git.

# Konnect: a personal access token (kpat_...), your AI Gateway's id, and its region (eu, us, me, ...)
KONNECT_TOKEN=
AI_GATEWAY_ID=
KONGCTL_DEFAULT_KONNECT_REGION=

# Your AI Gateway's endpoints, from its data plane node page in Konnect (host names only)
# e.g. 1a2b3c4d5e.eu.cp.konghq.com and 1a2b3c4d5e.eu.tp.konghq.com
KONNECT_CP_HOST=
KONNECT_TP_HOST=

# OpenAI: the agent's model in Act 4
OPENAI_API_KEY=

# The header each factory node gets from Kong (any random string; setup.sh generates them)
GNB_NODE_DC1=
GNB_NODE_DC2=

# Optional: your Konnect Analytics dashboard and cost report, for the Run tab's shortcuts
# (without them, the shortcuts open the Analytics lists)
KONNECT_DASHBOARD_URL=
KONNECT_COST_REPORT_URL=
